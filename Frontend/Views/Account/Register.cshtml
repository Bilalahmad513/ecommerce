@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register - ECommerceApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @await Html.PartialAsync("_ApiConfig")
</head>
<body>
    <div class="auth-split-page">
        <div class="auth-split-wrapper">
            <div class="auth-split-left">
                <div class="auth-split-breadcrumb">
                    <a asp-controller="Home" asp-action="Index">Home</a> / Create account
                </div>

                <div class="auth-split-form-inner">
                    <h2>Create your account</h2>
                    <p class="subtitle">Sign up to track orders, save your wishlist and check out faster.</p>

                    <div data-form-error class="alert alert-danger d-none"></div>

                    <form id="registerForm">
                        <div class="mb-3">
                            <label class="form-label">Full Name *</label>
                            <input name="fullName" required class="form-control" placeholder="e.g. Ali Khan" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email *</label>
                            <input name="email" type="email" required class="form-control" placeholder="you@example.com" />
                        </div>
                        <div class="row g-3 mb-1">
                            <div class="col-md-6">
                                <label class="form-label">Password *</label>
                                <input id="regPassword" name="password" type="password" minlength="6" required class="form-control" />
                                <p class="auth-split-hint">Use 6 or more characters with a number and a symbol.</p>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Confirm Password *</label>
                                <input id="regConfirmPassword" name="confirmPassword" type="password" required class="form-control" />
                            </div>
                        </div>

                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="agreeTerms" required />
                            <label class="form-check-label" for="agreeTerms">
                                I agree to the Terms &amp; Conditions and Privacy&nbsp;Policy&nbsp;*
                            </label>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="marketingOptIn" checked />
                            <label class="form-check-label" for="marketingOptIn">
                                Send me deals, new arrivals and discount codes
                            </label>
                        </div>

                        <button type="submit" class="btn auth-split-btn w-100">Create Account</button>
                    </form>

                    <p class="text-center mt-3 mb-0">Already have an account? <a asp-action="Login">Login here</a>.</p>
                </div>
            </div>

            <div class="auth-split-right">
                <div class="auth-split-right-inner">
                    <span class="auth-split-badge">New customer offer</span>
                    <h1>Get 10% off your first order</h1>
                    <p>Create your account and the discount code will be sent to your email right away.</p>

                    <div class="auth-split-illustration">
                        <svg width="220" height="170" viewBox="0 0 220 170" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="10" y="95" width="70" height="60" rx="6" fill="#1c2947" />
                            <rect x="30" y="70" width="55" height="45" rx="6" fill="#243256" />
                            <rect x="95" y="45" width="95" height="105" rx="10" fill="var(--auth-split-accent)" />
                            <path d="M118 45v-10a17 17 0 0 1 34 0v10" stroke="#fff" stroke-width="5" fill="none" stroke-linecap="round" />
                            <rect x="127" y="90" width="36" height="22" rx="3" fill="#fff" />
                            <text x="145" y="106" font-size="11" font-weight="700" fill="var(--auth-split-accent)" text-anchor="middle">SALE</text>
                            <circle cx="30" cy="55" r="5" fill="var(--auth-split-accent)" />
                            <circle cx="200" cy="150" r="4" fill="#3a4770" />
                        </svg>
                    </div>

                    <p class="auth-split-code-note">Use code at checkout.</p>
                </div>
            </div>
        </div>

        <div class="auth-split-features">
            <div class="auth-split-features-inner">
                <div class="auth-split-feature">
                    <span class="auth-split-feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2" /><path d="M15 18H9" /><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14" /><circle cx="17" cy="18" r="2" /><circle cx="7" cy="18" r="2" /></svg>
                    </span>
                    <div>
                        <div class="auth-split-feature-title">Fast delivery</div>
                        <div class="auth-split-feature-sub">To your doorstep, nationwide</div>
                    </div>
                </div>
                <div class="auth-split-feature">
                    <span class="auth-split-feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2" /><circle cx="12" cy="12" r="2" /></svg>
                    </span>
                    <div>
                        <div class="auth-split-feature-title">Cash on delivery</div>
                        <div class="auth-split-feature-sub">Pay when your order arrives</div>
                    </div>
                </div>
                <div class="auth-split-feature">
                    <span class="auth-split-feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /></svg>
                    </span>
                    <div>
                        <div class="auth-split-feature-title">7-day easy returns</div>
                        <div class="auth-split-feature-sub">Changed your mind? Send it back</div>
                    </div>
                </div>
                <div class="auth-split-feature">
                    <span class="auth-split-feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" /></svg>
                    </span>
                    <div>
                        <div class="auth-split-feature-title">Secure payments</div>
                        <div class="auth-split-feature-sub">Your details are always protected</div>
                    </div>
                </div>
            </div>
        </div>

        <footer class="auth-split-footer">
            <div class="auth-split-footer-inner">
                <span>&copy; 2026 ECommerceApp. All rights reserved.</span>
                <div class="auth-split-payment-badges">
                    <span>We accept:</span>
                    <span>Visa</span>
                    <span>Mastercard</span>
                    <span>JazzCash</span>
                    <span>Easypaisa</span>
                    <span>COD</span>
                </div>
            </div>
        </footer>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/api.js"></script>
    <script src="~/js/auth.js"></script>
    <script src="~/js/pages/register.js"></script>
</body>
</html>

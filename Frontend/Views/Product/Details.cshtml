@model ProductVm
@{
    ViewData["Title"] = Model.Name;

    string StockClass(int stock) => stock switch
    {
        0 => "out-of-stock",
        <= 5 => "low-stock",
        _ => "in-stock"
    };

    string StockText(int stock) => stock switch
    {
        0 => "Out of stock",
        <= 5 => $"Only {stock} left",
        _ => $"{stock} in stock"
    };
}

<a class="btn btn-link ps-0 mb-2" asp-controller="Home" asp-action="Index">&larr; Back to shop</a>

<div class="row g-4">
    <div class="col-md-5">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="img-fluid rounded-3 border" alt="@Model.Name" style="width:100%; max-height:340px; object-fit:cover;" />
        }
        else
        {
            <div class="product-thumb-placeholder rounded-3" style="height:340px; font-size:3rem;">@Model.Name.Trim().FirstOrDefault().ToString().ToUpper()</div>
        }
    </div>
    <div class="col-md-7">
        <div class="card-panel h-100">
            <p class="text-muted small mb-1">@Model.CategoryName</p>
            <h2 class="mb-2">@Model.Name</h2>
            <p class="text-muted">@Model.Description</p>

            <div class="d-flex align-items-center gap-3 my-3">
                <span class="product-price fs-3">Rs. @Model.Price.ToString("N2")</span>
                <span class="stock-pill @StockClass(Model.Stock)">@StockText(Model.Stock)</span>
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Cart" asp-action="Add" method="post" class="row g-2 align-items-center">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <div class="col-auto">
                        <label class="col-form-label">Quantity</label>
                    </div>
                    <div class="col-auto">
                        <input type="number" name="quantity" value="1" min="1" max="@Model.Stock" class="form-control" style="width: 90px;" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary" disabled="@(Model.Stock == 0)">Add to Cart</button>
                    </div>
                </form>
            }
            else
            {
                <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Login to Order</a>
            }
        </div>
    </div>
</div>

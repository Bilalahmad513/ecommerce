@{
    ViewData["Title"] = "Delete Product";
    var productId = ViewData["ProductId"];
    ViewData["Breadcrumb"] = "Inventory > Products > Delete";
}

<div class="page-title">
    <h2>Delete Product</h2>
</div>

<div class="card-panel" style="max-width: 480px;" data-product-id="@productId" id="deleteProductPanel">
    <p id="deleteProductPrompt">Are you sure you want to delete this product?</p>

    <dl class="row" id="deleteProductDetails"></dl>

    <div data-form-error class="alert alert-danger d-none"></div>

    <button type="button" id="confirmDeleteBtn" class="btn btn-danger">Delete</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</div>

@section Scripts {
    <script src="~/js/pages/admin-products-delete.js"></script>
}

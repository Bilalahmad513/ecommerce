@{
    ViewData["Title"] = "Add Product";
    ViewData["Breadcrumb"] = "Inventory > Products > Add";
}

<div class="page-title">
    <h2>Add Product</h2>
</div>

<div class="card-panel" style="max-width: 560px;">
    <div data-form-error class="alert alert-danger d-none"></div>

    <form id="productForm" data-product-id="">
        <div class="mb-3">
            <label class="form-label">Name</label>
            <input name="name" required class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Product Image (URL)</label>
            <input name="imageUrl" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Sale Price</label>
            <input name="price" type="number" step="0.01" min="0.01" max="1000000" required class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Category</label>
            <select name="categoryId" required class="form-select" id="categorySelect">
                <option value="">-- Select category --</option>
            </select>
        </div>
        <input type="hidden" name="description" value="" />
        <input type="hidden" name="stock" value="100" />
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-link" asp-action="Index">Cancel</a>
    </form>
</div>

@section Scripts {
    <script src="~/js/pages/admin-products-form.js"></script>
}

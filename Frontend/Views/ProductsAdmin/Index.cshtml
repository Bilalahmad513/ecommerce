@{
    ViewData["Title"] = "Manage Products";
    ViewData["Breadcrumb"] = "Inventory > Products";
}

<div class="page-title d-flex justify-content-between align-items-end flex-wrap gap-2">
    <div>
        <h2>Products</h2>
        <p>Browse and manage everything available in the store.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" id="exportBtn" class="btn btn-outline-secondary">Export</button>
        <a class="btn btn-primary" asp-action="Create">+ Add Product</a>
    </div>
</div>

<div class="stat-cards">
    <div class="stat-card">
        <div class="stat-card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" /><path d="M3 6h18" /><path d="M16 10a4 4 0 0 1-8 0" /></svg>
        </div>
        <div>
            <div class="stat-card-label">Total products</div>
            <div class="stat-card-value" id="statTotalProducts">0</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M9 21V9" /></svg>
        </div>
        <div>
            <div class="stat-card-label">Units in stock</div>
            <div class="stat-card-value" id="statUnitsInStock">0</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3.24L3 3v6.59a2 2 0 0 0 .59 1.41l9.58 9.58a2 2 0 0 0 2.82 0l4.6-4.6a2 2 0 0 0 0-2.82Z" /><circle cx="7.5" cy="7.5" r="1" /></svg>
        </div>
        <div>
            <div class="stat-card-label">Categories</div>
            <div class="stat-card-value" id="statCategories">0</div>
        </div>
    </div>
</div>

<div class="filter-bar">
    <div class="filter-tabs" id="stockFilterTabs">
        <button type="button" class="filter-tab active" data-filter="all">All products <span id="tabCountAll"></span></button>
        <button type="button" class="filter-tab" data-filter="in">In stock</button>
        <button type="button" class="filter-tab" data-filter="low">Low stock</button>
        <button type="button" class="filter-tab" data-filter="out">Out of stock</button>
    </div>
    <div class="filter-bar-controls">
        <select id="categoryFilter" class="form-select form-select-sm">
            <option value="">All categories</option>
        </select>
        <select id="sortSelect" class="form-select form-select-sm">
            <option value="newest">Sort: Newest</option>
            <option value="name">Sort: Name</option>
            <option value="price-asc">Sort: Price (low to high)</option>
            <option value="price-desc">Sort: Price (high to low)</option>
        </select>
    </div>
</div>

<div id="productsContainer"></div>

@section Scripts {
    <script src="~/js/pages/admin-products-index.js"></script>
}

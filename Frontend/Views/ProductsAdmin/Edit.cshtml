@{
    ViewData["Title"] = "Edit Product";
    var productId = ViewData["ProductId"];
    ViewData["Breadcrumb"] = "Inventory > Products > Edit";
}

<div class="page-title">
    <h2>Edit Product</h2>
</div>

<div class="card-panel" style="max-width: 560px;">
    <div data-form-error class="alert alert-danger d-none"></div>

    <form id="productForm" data-product-id="@productId">
        <div class="mb-3">
            <label class="form-label">Name</label>
            <input name="name" required class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Price</label>
            <input name="price" type="number" step="0.01" min="0.01" max="1000000" required class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Stock</label>
            <input name="stock" type="number" min="0" max="1000000" required class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Image URL (optional)</label>
            <input name="imageUrl" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Category</label>
            <select name="categoryId" required class="form-select" id="categorySelect">
                <option value="">-- Select category --</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-link" asp-action="Index">Cancel</a>
    </form>
</div>

@section Scripts {
    <script src="~/js/pages/admin-products-form.js"></script>
}

@{
    ViewData["Title"] = "Shop";
}

<div class="page-title d-flex justify-content-between align-items-end flex-wrap gap-2">
    <div>
        <h2>Products</h2>
        <p>Browse everything available in the store.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <select id="categoryFilter" class="form-select form-select-sm" style="width:auto;">
            <option value="">All Categories</option>
        </select>
        <a id="addProductLink" class="btn btn-success d-none" asp-controller="ProductsAdmin" asp-action="Create">+ Add Product</a>
    </div>
</div>

<div id="productGrid"></div>

@section Scripts {
    <script src="~/js/pages/home.js"></script>
}

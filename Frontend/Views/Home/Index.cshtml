@model List<ProductVm>
@{
    ViewData["Title"] = "Shop";

    string StockClass(int stock) => stock switch
    {
        0 => "out-of-stock",
        <= 5 => "low-stock",
        _ => "in-stock"
    };

    string StockText(int stock) => stock switch
    {
        0 => "Out of stock",
        <= 5 => $"Only {stock} left",
        _ => $"{stock} in stock"
    };
}

<div class="page-title d-flex justify-content-between align-items-end flex-wrap gap-2">
    <div>
        <h2>Products</h2>
        <p>Browse everything available in the store.</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-success" asp-controller="ProductsAdmin" asp-action="Create">+ Add Product</a>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state card-panel">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" /><path d="M3 6h18" /><path d="M16 10a4 4 0 0 1-8 0" /></svg>
        <p class="mb-0">No products available yet.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var product in Model)
        {
            <div class="col">
                <div class="product-card h-100 d-flex flex-column">
                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" class="product-thumb" alt="@product.Name" />
                    }
                    else
                    {
                        <div class="product-thumb-placeholder">@product.Name.Trim().FirstOrDefault().ToString().ToUpper()</div>
                    }
                    <div class="card-body d-flex flex-column flex-grow-1">
                        <p class="text-muted small mb-1">@product.CategoryName</p>
                        <h5 class="mb-2">@product.Name</h5>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="product-price">Rs. @product.Price.ToString("N2")</span>
                            <span class="stock-pill @StockClass(product.Stock)">@StockText(product.Stock)</span>
                        </div>
                        <div class="mt-auto d-flex gap-2">
                            <a class="btn btn-outline-primary btn-sm flex-grow-1" asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">Details</a>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-controller="Cart" asp-action="Add" method="post" class="flex-grow-1">
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-primary btn-sm w-100" disabled="@(product.Stock == 0)">Add to Cart</button>
                                </form>
                            }
                            else
                            {
                                <a class="btn btn-primary btn-sm flex-grow-1" asp-controller="Account" asp-action="Login">Login to Order</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

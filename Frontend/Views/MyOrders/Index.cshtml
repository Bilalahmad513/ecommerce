@model List<OrderVm>
@{
    ViewData["Title"] = "My Orders";

    string Label(string status) => status switch
    {
        "OnDelivery" => "On Delivery",
        _ => status
    };

    string BadgeClass(string status) => status switch
    {
        "Open" => "bg-secondary",
        "Accepted" => "bg-info text-dark",
        "Preparation" => "bg-warning text-dark",
        "OnDelivery" => "bg-primary",
        "Delivered" => "bg-success",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="page-title">
    <h2>My Orders</h2>
    <p>Track the status of everything you've ordered.</p>
</div>

@if (!Model.Any())
{
    <div class="empty-state card-panel">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" /><rect x="8" y="2" width="8" height="4" rx="1" /><path d="M9 12h6M9 16h6" /></svg>
        <p class="mb-2">You haven't placed any orders yet.</p>
        <a asp-controller="Home" asp-action="Index">Start shopping &rarr;</a>
    </div>
}
else
{
    <div class="table-panel">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Date</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td class="fw-semibold">#@order.Id</td>
                        <td>@order.OrderDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                        <td>
                            <ul class="list-unstyled mb-0">
                                @foreach (var item in order.Items)
                                {
                                    <li>@item.ProductName &times; @item.Quantity</li>
                                }
                            </ul>
                        </td>
                        <td class="fw-semibold">Rs. @order.TotalAmount.ToString("N2")</td>
                        <td><span class="badge @BadgeClass(order.Status)">@Label(order.Status)</span></td>
                        <td style="width: 160px;">
                            @if (order.Status == "OnDelivery")
                            {
                                <form asp-action="ConfirmDelivery" asp-route-id="@order.Id" method="post">
                                    <select name="action" class="form-select form-select-sm" onchange="this.form.submit()">
                                        <option value="" selected disabled>On Delivery</option>
                                        <option value="received">Order Received</option>
                                    </select>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

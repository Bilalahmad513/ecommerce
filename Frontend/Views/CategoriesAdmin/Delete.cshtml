@{
    ViewData["Title"] = "Delete Category";
    var categoryId = ViewData["CategoryId"];
    ViewData["Breadcrumb"] = "Inventory > Categories > Delete";
}

<div class="page-title">
    <h2>Delete Category</h2>
</div>

<div class="card-panel" style="max-width: 480px;" data-category-id="@categoryId" id="deleteCategoryPanel">
    <p id="deleteCategoryPrompt">Are you sure you want to delete this category?</p>

    <div data-form-error class="alert alert-danger d-none"></div>

    <button type="button" id="confirmDeleteBtn" class="btn btn-danger">Delete</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</div>

@section Scripts {
    <script src="~/js/pages/admin-categories-delete.js"></script>
}

@{
    ViewData["Title"] = "Checkout";
}

<div class="page-title">
    <h2>Checkout</h2>
    <p>Confirm your details before placing the order.</p>
</div>

<div data-form-error class="alert alert-danger d-none"></div>

<form id="checkoutForm">
    <div class="row g-4">
        <div class="col-lg-7 d-flex flex-column gap-4">
            <div class="card-panel">
                <h5 class="mb-3">Customer Information</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Full Name</label>
                        <input name="fullName" required class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email Address</label>
                        <input id="checkoutEmail" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Phone Number</label>
                        <input name="phone" type="tel" required class="form-control" placeholder="e.g. 03001234567" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Shipping Address</label>
                        <textarea name="shippingAddress" required class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>

            <div class="card-panel">
                <h5 class="mb-3">Payment Information</h5>
                <input type="hidden" name="paymentMethod" value="Online" />
                <div class="payment-option selected">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2" /><line x1="2" x2="22" y1="10" y2="10" /></svg>
                    <div>
                        <div class="fw-semibold">Online Payment</div>
                        <div class="text-muted small">Pay securely online. More payment options coming soon.</div>
                    </div>
                    <span class="badge bg-primary ms-auto">Selected</span>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card-panel">
                <h5 class="mb-3">Order Summary</h5>
                <ul id="orderSummaryList" class="list-unstyled mb-3"></ul>
                <div class="d-flex justify-content-between fs-5 fw-bold mb-3">
                    <span>Grand Total</span>
                    <span id="grandTotal"></span>
                </div>
                <button type="submit" class="btn btn-success w-100">Place Order</button>
                <a class="btn btn-link w-100 mt-1" asp-controller="Cart" asp-action="Index">&larr; Back to Cart</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/pages/checkout.js"></script>
}
